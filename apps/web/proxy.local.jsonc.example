{
  "$schema": "./proxy.schema.json",

  // 可选：本地开发服务端口。缺省时回退 DEV_SERVER_PORT，再回退 5173。
  // "server.port": 5173,

  // 可选：本地开启 Mock 服务（默认 false，常规启动直连真实 API / 代理）。
  // 它只打开服务；单个端点用自己 defineMock 记录的 enabled 控制（默认 true，设为 false 即透传）。
  // "mock": {
  //   "enabled": true
  // },

  // 可选：共享 Bearer Token，默认发给下面全部代理规则和网关兜底规则。
  // 缺省时回退 DEV_API_TOKEN；单条规则可用自己的 token 覆盖，空字符串表示该规则不发送。
  // 启动日志会按规则标注 Authorization 来源（不打印 Token 值），可核对 Token 发给了哪些服务。
  // "server.proxy.token": "",

  "server.proxy.api": {
    "/dysec/api/example-service": {
      "target": "http://127.0.0.1:8080"
    }

    // 本机裸服务不需要鉴权时，用空字符串退出共享 Token 的继承：
    // "/dysec/api/another-service": {
    //   "target": "http://127.0.0.1:8081",
    //   "token": ""
    // }
  }
}
