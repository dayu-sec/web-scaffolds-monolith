{
  "name": "web-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @workspace/web dev",
    "dev:mock": "pnpm --filter @workspace/web dev:mock",
    "build": "pnpm --filter @workspace/web build",
    "preview": "pnpm --filter @workspace/web preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "check": "pnpm --filter @workspace/ui check && pnpm --filter @workspace/web check",
    "test": "pnpm --filter @workspace/web test",
    "deps-check": "ncu --workspaces",
    "deps-update": "ncu --workspaces -u -t minor",
    "deps-interactive": "ncu --workspaces -i",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks"
  },
  "devDependencies": {
    "lint-staged": "17.0.8",
    "npm-check-updates": "22.2.9",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "picocolors": "1.1.1",
    "shadcn": "4.17.0",
    "simple-git-hooks": "2.13.1",
    "typescript": "6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "node scripts/verify-commit.js \"$1\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt"
    ],
    "*.{json,jsonc,md,yml,yaml,css,html}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@11.25.0"
}
