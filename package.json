{
  "name": "web-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint --cache .",
    "format": "prettier --write --cache .",
    "format-check": "prettier --check --cache .",
    "check": "tsc --incremental --noEmit",
    "test": "node --test --import tsx test/*.test.ts src/views/layout/__tests__/*.test.ts",
    "deps-check": "ncu",
    "deps-update": "ncu -u -t minor",
    "deps-interactive": "ncu -i",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/pro-components": "3.1.14-2",
    "@antv/g6": "5.1.1",
    "@antv/g6-extension-react": "0.2.7",
    "@antv/x6": "3.1.7",
    "@codemirror/lang-json": "6.0.2",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@dayu-sec/bizcom-theme": "1.0.0",
    "@dayu-sec/bizlib-request": "1.0.0",
    "@dayu-sec/bizlib-shared-types": "1.0.1",
    "@monaco-editor/react": "4.7.0",
    "@react-querybuilder/antd": "8.20.2",
    "@react-querybuilder/dnd": "8.20.2",
    "@seed-fe/batch-request": "1.0.0",
    "@seed-fe/event-channel": "1.0.0",
    "@seed-fe/global": "1.0.1",
    "@seed-fe/logger": "1.1.0",
    "@seed-fe/react-permission": "2.0.0-alpha.1",
    "@seed-fe/slashify": "1.0.0-alpha.0",
    "@tanstack/react-query": "5.101.2",
    "@uiw/react-codemirror": "4.25.11",
    "@wangeditor/editor": "5.1.23",
    "@wangeditor/editor-for-react": "1.0.6",
    "ahooks": "3.9.7",
    "antd": "6.5.1",
    "axios": "1.18.1",
    "change-case": "5.4.4",
    "clsx": "2.1.1",
    "copy-to-clipboard": "4.0.2",
    "dayjs": "1.11.21",
    "dompurify": "3.4.12",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "filesize": "11.0.22",
    "highlight.js": "11.11.1",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-backend": "4.0.0",
    "immer": "11.1.11",
    "ipaddr.js": "2.4.0",
    "katex": "0.17.0",
    "lodash-es": "4.18.1",
    "lucide-react": "1.24.0",
    "monaco-editor": "0.55.1",
    "qs": "6.15.3",
    "re-resizable": "6.11.2",
    "react": "19.2.7",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.9",
    "react-markdown": "10.1.0",
    "react-querybuilder": "8.20.2",
    "react-resizable": "4.0.2",
    "react-router": "7.18.1",
    "react-router-dom": "7.18.1",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.3.1",
    "tldts": "7.4.8",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.5.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/lodash-es": "4.17.12",
    "@types/node": "25.9.5",
    "@types/qs": "6.15.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "code-inspector-plugin": "1.6.6",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "globals": "17.7.0",
    "lint-staged": "17.0.8",
    "mockjs": "1.1.0",
    "npm-check-updates": "22.2.9",
    "picocolors": "1.1.1",
    "prettier": "3.9.5",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vite-plugin-mock-dev-server": "2.4.1",
    "vite-plugin-pages": "0.33.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm check",
    "commit-msg": "node scripts/verify-commit.js \"$1\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --cache"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write --cache"
    ]
  }
}
